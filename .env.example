# Server
PORT=3000                           # Port the server will listen on

# Database
DB_HOST=localhost                   # Your database host (localhost for local dev)
DB_PORT=5432                        # Default PostgreSQL port
DB_NAME=                            # Your database name
DB_USER=                            # Your database user
DB_PASSWORD=                        # Your database password

# JWT
JWT_SECRET=                         # Long random string — used to sign access tokens
JWT_REFRESH_SECRET=                 # Different long random string — used to sign refresh tokens
JWT_EXPIRES_IN=15m                  # Access token expiry (e.g. 15m, 1h)
JWT_REFRESH_EXPIRY=7d               # Refresh token expiry (e.g. 7d, 30d)

# CORS
CORS_ORIGIN=http://localhost:5173   # Your frontend URL — only this origin can make requests
